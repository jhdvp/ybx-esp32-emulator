+            uint64_t start = (uint32_t)s->addr;
+            const uint64_t size_bytes = (uint64_t)s->size_mbytes * 1024 * 1024;
+            if (start < size_bytes) {
+                memory_region_set_dirty(&s->data_mr, start,
+                    MIN((uint64_t)s->byte_count, size_bytes - start));
+            }
         }
         s->state = ST_IDLE;
         s->byte_count = 0;
