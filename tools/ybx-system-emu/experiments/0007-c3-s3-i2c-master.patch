     Fifo8 tx_fifo;
     bool trans_ongoing;
+    bool modern_cmd_encoding;
 
     uint32_t ctr_reg;
     uint32_t timeout_reg;
@@ -52,6 +53,7 @@
 
 REG32(I2C_TIMEOUT, 0x0c);
 
+REG32(I2C_FIFO_ST, 0x14);
 REG32(I2C_FIFO_CONF, 0x18);
     FIELD(I2C_FIFO_CONF, NONFIFO_EN, 10, 1);
     FIELD(I2C_FIFO_CONF, RX_FIFO_RST, 12, 1);
@@ -105,5 +107,10 @@
     I2C_OPCODE_STOP   = 3,
     I2C_OPCODE_END    = 4,
 } i2c_opcode_t;
+/* ESP-IDF 5 on C3/S3: unlike the classic ESP32, RESTART=6,
+ * STOP=2, READ=3. Memory-mapped register offsets are shared. */
+#define I2C_MODERN_OPCODE_RSTART 6
+#define I2C_MODERN_OPCODE_READ   3
+#define I2C_MODERN_OPCODE_STOP   2
 
 #endif /* ESP32_I2C_H */
