@@ -14,7 +14,23 @@
 
 static void epd_set_busy(YbxSSD1677State *s, bool busy)
 {
+    bool was_high = s->busy_level != 0;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+
+    if (busy != was_high) {
+        if (busy) {
+            s->busy_rise_edges++;
+            s->busy_started_ms = now;
+        } else {
+            s->busy_fall_edges++;
+            if (now > s->busy_started_ms) {
+                s->busy_high_ms += now - s->busy_started_ms;
+            }
+        }
+    }
     s->busy_level = busy;
+    /* Always drive: GPIO6 may be parked high by a board pullup while the model
+     * still believes it is low, and the panel has to release it anyway. */
     qemu_set_irq(s->busy, busy);
 }
 static void epd_refresh_completed(void *opaque)
@@ -153,7 +169,8 @@
             /* 0x20 also powers ON/OFF; CTRL2 bit2 starts the
              * actual pixel-update waveform. Do not count pure
              * 0xC0 power-on or 0x03 power-off as displayed frames. */
-            if (s->update_ctrl2 & 0x04) {
+            bool waveform = s->update_ctrl2 & 0x04;
+            if (waveform) {
                 memcpy(s->visible, s->ram, YBX_EPD_SIZE);
                 s->frames++;
                 s->nonwhite_visible = 0;
@@ -161,9 +178,12 @@
                     s->nonwhite_visible += (s->visible[i] != 0xff);
                 }
             }
+            /* Real power/booster-only activation ramps in a few ms, a pixel
+             * waveform in hundreds. Default properties keep both at 350 ms. */
             epd_set_busy(s, true);
             timer_mod(s->refresh_timer,
-                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 350);
+                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                      (waveform ? s->busy_waveform_ms : s->busy_power_ms));
         }
         return 0xff;
     }
