+static void esp32_gpio_inject_input(void *opaque, int n, int level)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    if (n >= ESP32_GPIO_PINS || n < 0) {
+        return;
+    }
+    uint32_t *word = n < 32 ? &s->input_lo : &s->input_hi;
+    uint32_t mask = 1U << (n < 32 ? n : n - 32);
+    if (level) {
+        *word |= mask;
+    } else {
+        *word &= ~mask;
+    }
+}
