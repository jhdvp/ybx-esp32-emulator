+
+static void gt911_update_irq(YbxGT911 *s)
+{
+    /* The board has configured GPIO10 as INPUT before normal polling.
+     * The virtual GPIO pin reports the high level while a new frame is
+     * pending; this is not yet a full ESP32 interrupt-matrix model. */
+    bool is_ready = s->powered && s->reset_high &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->ready_after_ns;
+    qemu_set_irq(s->touch_irq, is_ready && s->data_ready);
+}
+
+static void gt911_touch_state_get(Object *obj, Visitor *v,
+                                  const char *name, void *opaque,
+                                  Error **errp)
+{
+    YbxGT911 *s = YBX_GT911(obj);
+    int64_t value = s->injected_state;
+    visit_type_int(v, name, &value, errp);
+}
+
+static void gt911_touch_state_set(Object *obj, Visitor *v,
+                                  const char *name, void *opaque,
+                                  Error **errp)
+{
+    YbxGT911 *s = YBX_GT911(obj);
+    int64_t state;
+    if (!visit_type_int(v, name, &state, errp)) {
+        return;
+    }
+    if (state < 0 || state > 3) {
+        error_setg(errp, "injected-state must be 0 release, 1 contact, "
+                         "2 HOME press, or 3 HOME release");
+        return;
+    }
+    if (!s->powered || !s->reset_high ||
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) < s->ready_after_ns) {
+        error_setg(errp, "virtual GT911 must be powered and ready");
+        return;
+    }
+    if (s->injected_x > 479 || s->injected_y > 799) {
+        error_setg(errp, "virtual GT911 raw X/Y must be 0..479/0..799");
+        return;
+    }
+    s->injected_state = state;
+    s->data_ready = true;
+    gt911_update_irq(s);
+}
 
