+/* Hardware-confirmed X4 Pro: POWER is active-low GPIO3 / RTCIO3.
+ * One virtual board-level electrical level fans out to digital GPIO and RTC,
+ * never bypassing the guest EXT1 selection or directly resetting the CPU. */
+static bool esp32s3_x4pro_power_button_get(Object *obj, Error **errp)
+{
+    return ESP32S3_SOC(obj)->ybx_x4pro_power_button_pressed;
+}
+
+static void esp32s3_x4pro_power_button_set(Object *obj, bool pressed,
+                                          Error **errp)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(obj);
+    if (!s->ybx_x4pro_gt911) {
+        error_setg(errp, "X4 Pro power button requires the X4 Pro board profile");
+        return;
+    }
+    if (s->ybx_x4pro_power_button_pressed == pressed &&
+        s->ybx_x4pro_power_button_changes != 0) {
+        return;
+    }
+    s->ybx_x4pro_power_button_pressed = pressed;
+    s->ybx_x4pro_power_button_changes++;
+    int level = pressed ? 0 : 1; /* INPUT_PULLUP, active-LOW */
+    qemu_set_irq(qdev_get_gpio_in_named(DEVICE(&s->gpio),
+                                       "ybx.gpio-input", 3), level);
+    qemu_set_irq(qdev_get_gpio_in_named(DEVICE(&s->rtc_cntl),
+                                       ESP32S3_RTC_EXT1_PAD_IN, 3), level);
+}
+
 static void esp32s3_soc_init(Object *obj)
 {
     Esp32s3SocState *s = ESP32S3_SOC(obj);
