diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
index 4a24a04..0ebd71b 100644
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -933,6 +933,23 @@ static void esp32s3_machine_init(MachineState *machine)
         }
         g_free(rom_binary);
 
+        /* The ROM ELF has a non-empty DRAM data segment at 0x3fcd7000
+         * holding ROM runtime data and pointers. The plain IROM .bin
+         * above cannot initialize that segment. Load it separately.
+         * This is test-only board bring-up; match the exact ROM revision.
+         */
+        char *rom_dram_binary = qemu_find_file(QEMU_FILE_TYPE_BIOS,
+                                               "esp32s3_rev0_rom_dram.bin");
+        if (rom_dram_binary) {
+            int dram_len = load_image_targphys_as(
+                rom_dram_binary, 0x3fcd7000, 0x5b4, CPU(&ss->cpu[0])->as);
+            if (dram_len != 0x5b4) {
+                error_report("Invalid S3 ROM DRAM initialization image");
+                exit(1);
+            }
+            g_free(rom_dram_binary);
+        }
+
         if (ESP32S3_CPU_COUNT > 1)
         {
             rom_binary = qemu_find_file(QEMU_FILE_TYPE_BIOS, "esp32s3_rev0_rom.bin");
