+static void esp32s3_rtc_update_irq(Esp32s3RtcCntlState *s)
+{
+    qemu_set_irq(s->irq, !!(s->rtc_int_ena & s->rtc_int_raw));
+}
+
+/* Test-only external wake/reject sources, deliberately NOT automatic: RTC
+ * EXT1 and the real GPIO wake fabric are not modelled yet. Requiring an
+ * explicit QMP event prevents a fabricated automatic guest wakeup. */
+static void esp32s3_rtc_inject_event(Esp32s3RtcCntlState *s, uint32_t bit)
+{
+    if (!(s->state0_reg & R_RTC_CNTL_STATE0_SLEEP_EN_MASK)) {
+        return;
+    }
+    s->state0_reg &= ~R_RTC_CNTL_STATE0_SLEEP_EN_MASK;
+    if (bit == RTC_CNTL_SLP_WAKEUP_INT) {
+        s->state0_reg |= 1U << 29;
+        s->injected_wakeups++;
+    } else {
+        s->state0_reg |= 1U << 30;
+        s->injected_rejects++;
+    }
+    s->rtc_int_raw |= bit;
+    esp32s3_rtc_update_irq(s);
+}
+
+static bool esp32s3_rtc_get_event(Object *obj, Error **errp)
+{
+    return false;  /* write-one event, not a latching state property */
+}
+
+static void esp32s3_rtc_set_wakeup(Object *obj, bool event, Error **errp)
+{
+    if (event) {
+        esp32s3_rtc_inject_event(ESP32S3_RTC_CNTL(obj), RTC_CNTL_SLP_WAKEUP_INT);
+    }
+}
+
+static void esp32s3_rtc_set_reject(Object *obj, bool event, Error **errp)
+{
+    if (event) {
+        esp32s3_rtc_inject_event(ESP32S3_RTC_CNTL(obj), RTC_CNTL_SLP_REJECT_INT);
+    }
+}
