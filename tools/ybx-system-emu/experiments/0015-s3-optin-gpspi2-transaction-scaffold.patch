diff --git a/include/hw/ssi/ybx_esp32s3_spi2.h b/include/hw/ssi/ybx_esp32s3_spi2.h
new file mode 100644
--- /dev/null
+++ b/include/hw/ssi/ybx_esp32s3_spi2.h
@@ -0,0 +1,16 @@
+/* Experimental X4 Pro GP-SPI2 register/PIO scaffold, NOT a panel. */
+#pragma once
+#include "hw/sysbus.h"
+#include "hw/ssi/ssi.h"
+
+#define TYPE_YBX_S3_GPSPI2 "ybx.s3.gpspi2"
+OBJECT_DECLARE_SIMPLE_TYPE(YbxS3GPSpi2State, YBX_S3_GPSPI2)
+typedef struct YbxS3GPSpi2State {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    SSIBus *spi;
+    uint32_t regs[0x1000 / 4];
+    uint32_t bytes_sent;
+    uint32_t transfer_count;
+    uint32_t last_byte;
+} YbxS3GPSpi2State;
diff --git a/hw/ssi/ybx_esp32s3_spi2.c b/hw/ssi/ybx_esp32s3_spi2.c
new file mode 100644
--- /dev/null
+++ b/hw/ssi/ybx_esp32s3_spi2.c
@@ -0,0 +1,127 @@
+/*
+ * Experimental ESP32-S3 GP-SPI2 PIO register and user transfer scaffold.
+ * Correct GP-SPI2 offsets differ from SPI1 flash/PSRAM controller.
+ * No DMA/GDMA, GPIO matrix, EPD slave, busy pin, or display framebuffer
+ * implemented. Must not be called a working e-paper emulator.
+ */
+#include "qemu/osdep.h"
+#include "hw/ssi/ybx_esp32s3_spi2.h"
+#include "hw/ssi/ssi.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define GP_SPI_CMD 0x000
+#define GP_SPI_USR (1U << 24)
+#define GP_SPI_USER 0x010
+#define GP_SPI_USER2 0x018
+#define GP_SPI_MS_DLEN 0x01c
+#define GP_SPI_W0 0x098
+#define GP_SPI_BUFFER 64
+
+static uint64_t ybx_spi2_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    YbxS3GPSpi2State *s = opaque;
+    if (size != 4 || addr >= 0x1000) {
+        return 0;
+    }
+    return s->regs[addr / 4];
+}
+
+static void ybx_spi2_transfer(YbxS3GPSpi2State *s)
+{
+    /* CPU-controlled MOSI phase only. The genuine ESP32 SPI2 driver
+     * sends a value of bits-minus-one in MS_DLEN. */
+    if (!(s->regs[GP_SPI_USER / 4] & (1U << 27))) {
+        return;
+    }
+    uint32_t bits = (s->regs[GP_SPI_MS_DLEN / 4] & 0x3ffff) + 1;
+    uint32_t bytes = (bits + 7) / 8;
+    if (!bytes || bytes > GP_SPI_BUFFER) {
+        /* DMA and larger frames are explicitly NOT emulated. */
+        return;
+    }
+    if (s->regs[GP_SPI_USER / 4] & (1U << 31)) {
+        uint32_t cmd = s->regs[GP_SPI_USER2 / 4] & 0xffff;
+        uint32_t command_bits = ((s->regs[GP_SPI_USER2 / 4] >> 28) & 0xf) + 1;
+        for (uint32_t i = 0; i < (command_bits + 7) / 8; ++i) {
+            ssi_transfer(s->spi, (cmd >> (8 * i)) & 0xff);
+        }
+    }
+    const uint8_t *buffer = (const uint8_t *)&s->regs[GP_SPI_W0 / 4];
+    for (uint32_t i = 0; i < bytes; i++) {
+        uint8_t byte = buffer[i];
+        ssi_transfer(s->spi, byte);
+        s->last_byte = byte;
+    }
+    s->bytes_sent += bytes;
+    s->transfer_count++;
+}
+
+static void ybx_spi2_write(void *opaque, hwaddr addr,
+                           uint64_t value, unsigned int size)
+{
+    YbxS3GPSpi2State *s = opaque;
+    if (size != 4 || addr >= 0x1000) {
+        return;
+    }
+    s->regs[addr / 4] = (uint32_t)value;
+    if (addr == GP_SPI_CMD) {
+        if ((uint32_t)value & GP_SPI_USR) {
+            ybx_spi2_transfer(s);
+        }
+        /* GP-SPI2 SPI_CMD.UPDATE bit23 is a self-clearing register
+         * synchronization operation. If left high, ESP-IDF hangs
+         * polling for the SPI driver's configuration completion. */
+        s->regs[GP_SPI_CMD / 4] &= ~(GP_SPI_USR | (1U << 23));
+    }
+}
+
+static const MemoryRegionOps ybx_spi2_ops = {
+    .read = ybx_spi2_read,
+    .write = ybx_spi2_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {.min_access_size = 4, .max_access_size = 4},
+};
+
+static void ybx_spi2_reset(DeviceState *dev)
+{
+    YbxS3GPSpi2State *s = YBX_S3_GPSPI2(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->bytes_sent = s->transfer_count = s->last_byte = 0;
+}
+
+static void ybx_spi2_init(Object *obj)
+{
+    YbxS3GPSpi2State *s = YBX_S3_GPSPI2(obj);
+    memory_region_init_io(&s->iomem, obj, &ybx_spi2_ops, s,
+                          "ybx.s3.gpspi2.mmio", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    s->spi = ssi_create_bus(DEVICE(s), "spi");
+    object_property_add_uint32_ptr(obj, "bytes-sent", &s->bytes_sent,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "transactions", &s->transfer_count,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-byte", &s->last_byte,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void ybx_spi2_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, ybx_spi2_reset);
+}
+
+static const TypeInfo ybx_spi2_type = {
+    .name = TYPE_YBX_S3_GPSPI2,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(YbxS3GPSpi2State),
+    .instance_init = ybx_spi2_init,
+    .class_init = ybx_spi2_class_init,
+};
+static void ybx_spi2_register(void)
+{
+    type_register_static(&ybx_spi2_type);
+}
+type_init(ybx_spi2_register)
