+static void esp32_gpio_update_irq(Esp32GpioState *s)
+{
+    bool asserted = false;
+    for (int n = 0; n < ESP32_GPIO_PINS; ++n) {
+        uint32_t flag = 1U << (n < 32 ? n : n - 32);
+        uint32_t *status = n < 32 ? &s->status_lo : &s->status_hi;
+        uint32_t cfg = s->pin_cfg[n];
+        uint32_t type = PIN_TYPE(cfg);
+        bool high = !!((n < 32 ? s->input_lo : s->input_hi) & flag);
+        if (type == 4 || type == 5) {
+            if ((type == 4 && !high) || (type == 5 && high)) {
+                if (PIN_ENA(cfg)) *status |= flag;
+            } else {
+                *status &= ~flag;
+            }
+        }
+        if ((*status & flag) && (PIN_ENA(cfg) & 1)) asserted = true;
+    }
+    s->irq_level = asserted;
+    qemu_set_irq(s->irq, asserted);
