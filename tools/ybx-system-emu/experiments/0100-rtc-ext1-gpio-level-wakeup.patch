+/* EXT1 is level triggered, gated by guest-programmed RTC pin mask, mode
+ * and EXT1 enable. Unknown/unconnected pads cannot wake the guest. */
+static void esp32s3_rtc_ext1_check(Esp32s3RtcCntlState *s)
+{
+    uint32_t selected = s->ext1_sel & RTC_CNTL_EXT1_PAD_MASK;
+    uint32_t valid = s->ext1_pad_valid & selected;
+    uint32_t highs = s->ext1_pad_high & selected;
+    bool high_mode = !!(s->ext1_conf & RTC_CNTL_EXT1_ANY_HIGH_MODE);
+    uint32_t active = high_mode ? (valid & highs) : (selected & ~highs);
+
+    if (!(s->state0_reg & R_RTC_CNTL_STATE0_SLEEP_EN_MASK) ||
+        !(s->wakeup_state_reg & RTC_CNTL_EXT1_WAKEUP_EN) ||
+        !selected || !valid) {
+        return;
+    }
+    /* ANY_HIGH may wake on any known selected high; ALL_LOW requires every
+     * selected pad to be known and low, not just one of them. */
+    if ((high_mode && !active) ||
+        (!high_mode && (valid != selected || highs != 0))) {
+        return;
+    }
+    s->ext1_status = active & selected;
+    s->state0_reg &= ~R_RTC_CNTL_STATE0_SLEEP_EN_MASK;
+    s->rtc_int_raw &= ~RTC_CNTL_SLEEP_INT_MASK;
+    s->reset_cause[0] = ESP32_DEEPSLEEP_RESET;
+    s->reset_cause[1] = ESP32_DEEPSLEEP_RESET;
+    s->ext1_wake_events++;
+    s->deep_wake_resets++;
+    qemu_irq_pulse(s->dig_reset_req);
+}
+
+static void esp32s3_rtc_ext1_pad_input(void *opaque, int pin, int level)
+{
+    Esp32s3RtcCntlState *s = opaque;
+    if (pin < 0 || pin >= ESP32S3_RTC_EXT1_PADS) {
+        return;
+    }
+    uint32_t bit = 1U << pin;
+    s->ext1_pad_valid |= bit;
+    if (level) {
+        s->ext1_pad_high |= bit;
+    } else {
+        s->ext1_pad_high &= ~bit;
+    }
+    s->ext1_input_events++;
+    esp32s3_rtc_ext1_check(s);
+}
+
+static bool esp32s3_rtc_get_ext1_test_level(Object *obj, Error **errp)
+{
+    Esp32s3RtcCntlState *s = ESP32S3_RTC_CNTL(obj);
+    return s->ext1_test_pin < ESP32S3_RTC_EXT1_PADS &&
+           !!(s->ext1_pad_high & (1U << s->ext1_test_pin));
+}
+
+static void esp32s3_rtc_set_ext1_test_level(Object *obj, bool level, Error **errp)
+{
+    Esp32s3RtcCntlState *s = ESP32S3_RTC_CNTL(obj);
+    if (s->ext1_test_pin >= ESP32S3_RTC_EXT1_PADS) {
+        error_setg(errp, "EXT1 RTC pad must be in range 0..21");
+        return;
+    }
+    qemu_set_irq(qdev_get_gpio_in_named(DEVICE(s),
+                 ESP32S3_RTC_EXT1_PAD_IN, s->ext1_test_pin), level);
+}
