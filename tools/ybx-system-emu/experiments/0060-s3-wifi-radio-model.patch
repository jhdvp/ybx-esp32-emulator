diff --git a/include/hw/misc/esp32s3_wifi_stub.h b/include/hw/misc/esp32s3_wifi_stub.h
new file mode 100644
index 0000000..9b2158e
--- /dev/null
+++ b/include/hw/misc/esp32s3_wifi_stub.h
@@ -0,0 +1,63 @@
+/*
+ * ESP32-S3 opt-in Wi-Fi register stub (YBX emulator research)
+ *
+ * Copyright (c) 2026 YBX emulator batch.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ *
+ * NOT a radio. The device gives the modem register windows a coherent
+ * read/write model (silicon-like register storage, real get/clear event
+ * semantics that always report "no event") and counts every access. It
+ * never raises an interrupt, never ticks a TSF, never delivers a frame and
+ * therefore can never claim association, scan or a key install completed.
+ */
+
+#pragma once
+
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+
+#define TYPE_ESP32S3_WIFI_STUB "misc.esp32s3.wifi_stub"
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32s3WifiStubState, ESP32S3_WIFI_STUB)
+
+/* Register windows the factory X4 Pro image drives (measured from its own
+ * l32r literal pools; see tools/ybx-system-emu/experiments/0060). The WDEV
+ * window is split around ESP32S3_RNG_BASE (0x6003507c) so the existing TRNG
+ * device keeps ownership of those 4 bytes. */
+#define ESP32S3_WIFI_STUB_WINDOW_COUNT 6
+
+typedef struct Esp32s3WifiStubWindowInfo {
+    const char *name;
+    uint32_t base;
+    uint32_t size;
+} Esp32s3WifiStubWindowInfo;
+
+extern const Esp32s3WifiStubWindowInfo
+    esp32s3_wifi_stub_windows[ESP32S3_WIFI_STUB_WINDOW_COUNT];
+
+/* Statistics block, mapped inside the WDEV_HIGH window. Host-side
+ * observability only: the factory image never touches 0x60035f00 (the
+ * highest literal address measured in WDEV is 0x6003511c). */
+#define ESP32S3_WIFI_STUB_STATS_BASE 0x60035f00
+#define ESP32S3_WIFI_STUB_STATS_SIZE 0x20
+#define ESP32S3_WIFI_STUB_STATS_MAGIC 0x59425230 /* "YBR0" little-endian */
+
+#define ESP32S3_WIFI_STUB_MAX_WORDS 1024
+
+typedef struct Esp32s3WifiStubState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion mr[ESP32S3_WIFI_STUB_WINDOW_COUNT];
+    uint32_t regs[ESP32S3_WIFI_STUB_WINDOW_COUNT][ESP32S3_WIFI_STUB_MAX_WORDS];
+    struct Esp32s3WifiStubMmioCtx *ctx; /* window index for each mr[] */
+
+    bool tap;                 /* log first touch of each register word */
+    uint64_t reads;
+    uint64_t writes;
+    uint32_t last_read_addr;  /* absolute address */
+    uint32_t last_write_addr;
+    uint32_t last_write_value;
+    void *seen;               /* GHashTable of already-tapped addresses */
+} Esp32s3WifiStubState;
