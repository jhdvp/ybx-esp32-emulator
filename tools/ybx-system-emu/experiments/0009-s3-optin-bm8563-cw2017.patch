diff --git a/hw/i2c/ybx_x4pro_i2c.c b/hw/i2c/ybx_x4pro_i2c.c
--- /dev/null
+++ b/hw/i2c/ybx_x4pro_i2c.c
@@ -0,0 +1,229 @@
+/*
+ * YBX Xteink X4 Pro opt-in I2C simulation: BM8563 RTC and CW2017 gauge.
+ *
+ * These are explicitly SIMULATED peripherals, not measurements from hardware.
+ * No GT911 is attached (touch reset/power/interrupt behavior is not yet modeled).
+ * GPL-2.0-or-later, derived from QEMU's I2C slave interface conventions.
+ */
+#include "qemu/osdep.h"
+#include "qemu/bcd.h"
+#include "qemu/module.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-properties.h"
+#include "sysemu/rtc.h"
+
+#define TYPE_YBX_BM8563 "ybx.bm8563"
+#define TYPE_YBX_CW2017 "ybx.cw2017"
+OBJECT_DECLARE_SIMPLE_TYPE(YbxBM8563, YBX_BM8563)
+OBJECT_DECLARE_SIMPLE_TYPE(YbxCW2017, YBX_CW2017)
+
+struct YbxBM8563 {
+    I2CSlave parent_obj;
+    uint8_t regs[16];
+    uint8_t ptr;
+    bool want_ptr;
+    int64_t rtc_offset;
+};
+
+struct YbxCW2017 {
+    I2CSlave parent_obj;
+    uint8_t regs[0x60];
+    uint8_t written_profile[80];
+    uint8_t ptr;
+    bool want_ptr;
+    uint8_t simulated_soc;
+    uint32_t simulated_mv;
+    bool profile_valid;
+};
+
+static void bm8563_capture(YbxBM8563 *s)
+{
+    struct tm tm;
+    qemu_get_timedate(&tm, s->rtc_offset);
+    s->regs[0x02] = to_bcd(tm.tm_sec);
+    s->regs[0x03] = to_bcd(tm.tm_min);
+    s->regs[0x04] = to_bcd(tm.tm_hour);
+    s->regs[0x05] = to_bcd(tm.tm_mday);
+    s->regs[0x06] = tm.tm_wday;
+    s->regs[0x07] = to_bcd(tm.tm_mon + 1);
+    s->regs[0x08] = to_bcd(tm.tm_year % 100);
+}
+
+static int bm8563_event(I2CSlave *slave, enum i2c_event event)
+{
+    YbxBM8563 *s = YBX_BM8563(slave);
+    if (event == I2C_START_SEND) {
+        s->want_ptr = true;
+    } else if (event == I2C_START_RECV) {
+        bm8563_capture(s);
+    }
+    return 0;
+}
+
+static uint8_t bm8563_recv(I2CSlave *slave)
+{
+    YbxBM8563 *s = YBX_BM8563(slave);
+    uint8_t value = s->regs[s->ptr & 0x0f];
+    s->ptr = (s->ptr + 1) & 0x0f;
+    return value;
+}
+
+static int bm8563_send(I2CSlave *slave, uint8_t value)
+{
+    YbxBM8563 *s = YBX_BM8563(slave);
+    uint8_t reg = s->ptr & 0x0f;
+    if (s->want_ptr) {
+        s->ptr = value & 0x0f;
+        s->want_ptr = false;
+        return 0;
+    }
+    if (reg >= 0x02 && reg <= 0x08) {
+        struct tm tm;
+        qemu_get_timedate(&tm, s->rtc_offset);
+        switch (reg) {
+        case 0x02: tm.tm_sec = from_bcd(value & 0x7f); break;
+        case 0x03: tm.tm_min = from_bcd(value & 0x7f); break;
+        case 0x04: tm.tm_hour = from_bcd(value & 0x3f); break;
+        case 0x05: tm.tm_mday = from_bcd(value & 0x3f); break;
+        case 0x06: break; /* weekday is calculated from the current time */
+        case 0x07: tm.tm_mon = from_bcd(value & 0x1f) - 1; break;
+        case 0x08: tm.tm_year = from_bcd(value) + 100; break;
+        }
+        if (reg != 0x06) {
+            s->rtc_offset = qemu_timedate_diff(&tm);
+        }
+    } else {
+        s->regs[reg] = value;
+    }
+    s->ptr = (reg + 1) & 0x0f;
+    return 0;
+}
+
+static void bm8563_reset(DeviceState *dev)
+{
+    YbxBM8563 *s = YBX_BM8563(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->ptr = 0;
+    s->want_ptr = false;
+    s->rtc_offset = 0;
+}
+
+static void bm8563_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *ic = I2C_SLAVE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ic->event = bm8563_event;
+    ic->send = bm8563_send;
+    ic->recv = bm8563_recv;
+    device_class_set_legacy_reset(dc, bm8563_reset);
+}
+
+static void cw2017_refresh(YbxCW2017 *s)
+{
+    uint32_t raw = (s->simulated_mv * 16 + 2) / 5;
+    /* CW2017: 14-bit ADC raw, converted with (raw * 5 + 8) >> 4 */
+    raw = MIN(raw, 0x3fffU);
+    s->regs[0x00] = (s->regs[0x08] == 0) ? 0x0d : 0xa0;
+    s->regs[0x02] = raw >> 8;
+    s->regs[0x03] = raw & 0xff;
+    s->regs[0x04] = s->profile_valid ? s->simulated_soc : 0;
+    s->regs[0x05] = 0;
+}
+
+static int cw2017_event(I2CSlave *slave, enum i2c_event event)
+{
+    YbxCW2017 *s = YBX_CW2017(slave);
+    if (event == I2C_START_SEND) {
+        s->want_ptr = true;
+    } else if (event == I2C_START_RECV) {
+        cw2017_refresh(s);
+    }
+    return 0;
+}
+
+static uint8_t cw2017_recv(I2CSlave *slave)
+{
+    YbxCW2017 *s = YBX_CW2017(slave);
+    uint8_t value = s->regs[s->ptr % sizeof(s->regs)];
+    s->ptr = (s->ptr + 1) % sizeof(s->regs);
+    return value;
+}
+
+static int cw2017_send(I2CSlave *slave, uint8_t value)
+{
+    YbxCW2017 *s = YBX_CW2017(slave);
+    uint8_t reg = s->ptr % sizeof(s->regs);
+    if (s->want_ptr) {
+        s->ptr = value % sizeof(s->regs);
+        s->want_ptr = false;
+        return 0;
+    }
+    if (reg >= 0x10 && reg < 0x60) {
+        s->regs[reg] = value;
+        s->written_profile[reg - 0x10] = 1;
+        s->profile_valid = false;
+        s->regs[0x0b] &= ~0x80;
+    } else if (reg == 0x0b) {
+        bool full = true;
+        for (size_t n = 0; n < sizeof(s->written_profile); n++) {
+            full &= s->written_profile[n] != 0;
+        }
+        s->profile_valid = full && !!(value & 0x80);
+        s->regs[reg] = value & ~0x80;
+        if (s->profile_valid) {
+            s->regs[reg] |= 0x80;
+        }
+    } else if (reg == 0x08) {
+        s->regs[reg] = value;
+        cw2017_refresh(s);
+    } else if (reg != 0x00 && reg != 0x02 && reg != 0x03 && reg != 0x04) {
+        s->regs[reg] = value;
+    }
+    s->ptr = (reg + 1) % sizeof(s->regs);
+    return 0;
+}
+
+static void cw2017_reset(DeviceState *dev)
+{
+    YbxCW2017 *s = YBX_CW2017(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->written_profile, 0, sizeof(s->written_profile));
+    s->ptr = 0;
+    s->want_ptr = false;
+    s->profile_valid = false;
+    cw2017_refresh(s);
+}
+
+static Property cw2017_properties[] = {
+    DEFINE_PROP_UINT8("simulated-soc", YbxCW2017, simulated_soc, 70),
+    DEFINE_PROP_UINT32("simulated-mv", YbxCW2017, simulated_mv, 3800),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void cw2017_class_init(ObjectClass *klass, void *data)
+{
+    I2CSlaveClass *ic = I2C_SLAVE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ic->event = cw2017_event;
+    ic->send = cw2017_send;
+    ic->recv = cw2017_recv;
+    device_class_set_legacy_reset(dc, cw2017_reset);
+    device_class_set_props(dc, cw2017_properties);
+}
+
+static const TypeInfo types[] = {
+    {
+        .name = TYPE_YBX_BM8563,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(YbxBM8563),
+        .class_init = bm8563_class_init,
+    },
+    {
+        .name = TYPE_YBX_CW2017,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(YbxCW2017),
+        .class_init = cw2017_class_init,
+    },
+};
+
+DEFINE_TYPES(types)
