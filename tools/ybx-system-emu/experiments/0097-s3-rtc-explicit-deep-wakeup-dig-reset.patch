+/* An accepted deep sleep never returns to the guest instruction after
+ * RTC_CNTL_SLEEP_EN. A later external wake starts a *digital reset*, while
+ * the RTC domain and reset cause survive. This opt-in QMP input is a test
+ * hook, not an implementation of the EXT1/timer/GPIO wake fabric. */
+static void esp32s3_rtc_set_deep_wakeup(Object *obj, bool event, Error **errp)
+{
+    Esp32s3RtcCntlState *s = ESP32S3_RTC_CNTL(obj);
+
+    if (!event || !(s->state0_reg & R_RTC_CNTL_STATE0_SLEEP_EN_MASK)) {
+        return;
+    }
+    s->state0_reg &= ~R_RTC_CNTL_STATE0_SLEEP_EN_MASK;
+    s->rtc_int_raw &= ~RTC_CNTL_SLEEP_INT_MASK;
+    esp32s3_rtc_update_irq(s);
+    s->reset_cause[0] = ESP32_DEEPSLEEP_RESET;
+    s->reset_cause[1] = ESP32_DEEPSLEEP_RESET;
+    s->deep_wake_resets++;
+    qemu_irq_pulse(s->dig_reset_req);
+}
+
