diff --git a/include/hw/display/ybx_ssd1677.h b/include/hw/display/ybx_ssd1677.h
new file mode 100644
--- /dev/null
+++ b/include/hw/display/ybx_ssd1677.h
@@ -0,0 +1,35 @@
+/* Opt-in QEMU SSD1677 test panel, X4 Pro 800x480, not a physical emulator. */
+#pragma once
+#include "hw/ssi/ssi.h"
+#include "hw/irq.h"
+#include "qemu/timer.h"
+
+#define TYPE_YBX_SSD1677 "ybx.ssd1677"
+OBJECT_DECLARE_SIMPLE_TYPE(YbxSSD1677State, YBX_SSD1677)
+#define YBX_EPD_WIDTH 800
+#define YBX_EPD_HEIGHT 480
+#define YBX_EPD_ROW_BYTES 100
+#define YBX_EPD_SIZE (YBX_EPD_ROW_BYTES * YBX_EPD_HEIGHT)
+
+struct YbxSSD1677State {
+    SSIPeripheral parent_obj;
+    qemu_irq busy;
+    QEMUTimer *refresh_timer;
+    uint8_t ram[YBX_EPD_SIZE];
+    uint8_t visible[YBX_EPD_SIZE];
+    uint32_t frames;
+    uint32_t commands;
+    uint32_t data_bytes;
+    uint32_t ram_writes;
+    uint32_t ignored_bytes;
+    uint32_t last_command;
+    uint32_t busy_level;
+    uint32_t nonwhite_visible;
+    uint16_t x_start, x_end, y_start, y_end, x, y;
+    uint8_t command;
+    uint8_t params[5];
+    uint8_t param_len;
+    uint8_t data_entry;
+    bool dc_high;
+    bool rst_high;
+};
diff --git a/hw/display/ybx_ssd1677.c b/hw/display/ybx_ssd1677.c
new file mode 100644
--- /dev/null
+++ b/hw/display/ybx_ssd1677.c
@@ -0,0 +1,242 @@
+/*
+ * Experimental, QTest-verifiable SSD1677 panel command/data + RAM state.
+ * GPIO13 CS, GPIO18 D/C, GPIO14 RESET, GPIO6 BUSY. 800x480 1bpp.
+ * Not a physical electrophoretic display, waveform model, or color emulator.
+ */
+#include "qemu/osdep.h"
+#include "hw/display/ybx_ssd1677.h"
+#include "hw/ssi/ssi.h"
+#include "hw/qdev-properties.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "qom/object.h"
+
+static void epd_set_busy(YbxSSD1677State *s, bool busy)
+{
+    s->busy_level = busy;
+    qemu_set_irq(s->busy, busy);
+}
+static void epd_refresh_completed(void *opaque)
+{
+    epd_set_busy(opaque, false);
+}
+static void epd_clear_ram(YbxSSD1677State *s)
+{
+    memset(s->ram, 0xff, sizeof(s->ram));
+    s->x_start = 0;
+    s->x_end = YBX_EPD_ROW_BYTES - 1;
+    s->y_start = 0;
+    s->y_end = YBX_EPD_HEIGHT - 1;
+    s->x = 0;
+    s->y = 0;
+    s->data_entry = 0x03;
+    s->param_len = 0;
+}
+static void epd_reset_gpio(void *opaque, int n, int level)
+{
+    YbxSSD1677State *s = YBX_SSD1677(opaque);
+    bool high = !!level;
+    if (!high && s->rst_high) {
+        timer_del(s->refresh_timer);
+        epd_set_busy(s, false);
+        epd_clear_ram(s);
+    }
+    s->rst_high = high;
+}
+static void epd_dc_gpio(void *opaque, int n, int level)
+{
+    YbxSSD1677State *s = YBX_SSD1677(opaque);
+    s->dc_high = !!level;
+}
+static void epd_apply_params(YbxSSD1677State *s)
+{
+    switch (s->command) {
+    case 0x11:
+        if (s->param_len >= 1) {
+            s->data_entry = s->params[0];
+        }
+        break;
+    case 0x44:
+        if (s->param_len >= 2) {
+            s->x_start = MIN(s->params[0], YBX_EPD_ROW_BYTES - 1);
+            s->x_end = MIN(s->params[1], YBX_EPD_ROW_BYTES - 1);
+        }
+        break;
+    case 0x45:
+        if (s->param_len >= 4) {
+            s->y_start = MIN((s->params[1] << 8) | s->params[0],
+                             YBX_EPD_HEIGHT - 1);
+            s->y_end = MIN((s->params[3] << 8) | s->params[2],
+                           YBX_EPD_HEIGHT - 1);
+        }
+        break;
+    case 0x4e:
+        if (s->param_len >= 1) {
+            s->x = MIN(s->params[0], YBX_EPD_ROW_BYTES - 1);
+        }
+        break;
+    case 0x4f:
+        if (s->param_len >= 2) {
+            s->y = MIN((s->params[1] << 8) | s->params[0],
+                       YBX_EPD_HEIGHT - 1);
+        }
+        break;
+    default:
+        break;
+    }
+}
+static uint8_t epd_expected_params(uint8_t cmd)
+{
+    switch (cmd) {
+    case 0x11: return 1;
+    case 0x44: return 2;
+    case 0x45: return 4;
+    case 0x4e: return 1;
+    case 0x4f: return 2;
+    default: return 0;
+    }
+}
+static void epd_advance_ram(YbxSSD1677State *s)
+{
+    /* SSD1677 common X-increment/Y-increment mode (data entry 0x03).
+     * Support X-decrement and Y-decrement for physical scan orientation.
+     * Configuration register controls each direction independently.
+     */
+    bool inc_x = s->data_entry & 1;
+    bool inc_y = s->data_entry & 2;
+    if (inc_x) {
+        if (s->x >= s->x_end) {
+            s->x = s->x_start;
+            s->y = inc_y ? (s->y < s->y_end ? s->y + 1 : s->y_start) :
+                           (s->y > s->y_start ? s->y - 1 : s->y_end);
+        } else {
+            s->x++;
+        }
+    } else {
+        if (s->x <= s->x_start) {
+            s->x = s->x_end;
+            s->y = inc_y ? (s->y < s->y_end ? s->y + 1 : s->y_start) :
+                           (s->y > s->y_start ? s->y - 1 : s->y_end);
+        } else {
+            s->x--;
+        }
+    }
+}
+static uint32_t epd_transfer(SSIPeripheral *peripheral, uint32_t val)
+{
+    YbxSSD1677State *s = YBX_SSD1677(peripheral);
+    uint8_t byte = val & 0xff;
+    if (!s->rst_high) {
+        s->ignored_bytes++;
+        return 0xff;
+    }
+    if (!s->dc_high) {
+        s->command = byte;
+        s->last_command = byte;
+        s->commands++;
+        s->param_len = 0;
+        if (byte == 0x12) {
+            epd_clear_ram(s);
+            timer_del(s->refresh_timer);
+            epd_set_busy(s, false);
+        } else if (byte == 0x20) {
+            memcpy(s->visible, s->ram, YBX_EPD_SIZE);
+            s->frames++;
+            s->nonwhite_visible = 0;
+            for (int i = 0; i < YBX_EPD_SIZE; ++i) {
+                s->nonwhite_visible += (s->visible[i] != 0xff);
+            }
+            /* No real waveform. Time-bound virtual BUSY only. */
+            epd_set_busy(s, true);
+            timer_mod(s->refresh_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 350);
+        }
+        return 0xff;
+    }
+    s->data_bytes++;
+    uint8_t need = epd_expected_params(s->command);
+    if (need && s->param_len < need) {
+        s->params[s->param_len++] = byte;
+        if (s->param_len == need) {
+            epd_apply_params(s);
+        }
+    } else if (s->command == 0x24) {
+        if (s->x < YBX_EPD_ROW_BYTES && s->y < YBX_EPD_HEIGHT) {
+            s->ram[s->y * YBX_EPD_ROW_BYTES + s->x] = byte;
+            s->ram_writes++;
+        }
+        epd_advance_ram(s);
+    }
+    return 0xff;
+}
+static char *epd_get_visible_hex(Object *obj, Error **errp)
+{
+    YbxSSD1677State *s = YBX_SSD1677(obj);
+    static const char digits[] = "0123456789abcdef";
+    char *result = g_malloc(YBX_EPD_SIZE * 2 + 1);
+    for (size_t i = 0; i < YBX_EPD_SIZE; i++) {
+        result[2*i] = digits[s->visible[i] >> 4];
+        result[2*i+1] = digits[s->visible[i] & 0x0f];
+    }
+    result[2 * YBX_EPD_SIZE] = 0;
+    return result;
+}
+static void epd_reset(DeviceState *dev)
+{
+    YbxSSD1677State *s = YBX_SSD1677(dev);
+    epd_clear_ram(s);
+    memset(s->visible, 0xff, sizeof(s->visible));
+    s->frames = s->commands = s->data_bytes = s->ram_writes = 0;
+    s->ignored_bytes = s->last_command = s->nonwhite_visible = 0;
+    s->command = 0;
+    s->dc_high = true;
+    s->rst_high = true;
+    timer_del(s->refresh_timer);
+    epd_set_busy(s, false);
+}
+static void epd_realize(SSIPeripheral *peripheral, Error **errp)
+{
+    epd_reset(DEVICE(peripheral));
+}
+static void epd_init(Object *obj)
+{
+    YbxSSD1677State *s = YBX_SSD1677(obj);
+    s->refresh_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                    epd_refresh_completed, s);
+    qdev_init_gpio_in_named(DEVICE(s), epd_dc_gpio, "ybx.epd.dc", 1);
+    qdev_init_gpio_in_named(DEVICE(s), epd_reset_gpio, "ybx.epd.reset", 1);
+    qdev_init_gpio_out_named(DEVICE(s), &s->busy, "ybx.epd.busy", 1);
+    object_property_add_uint32_ptr(obj, "commands", &s->commands,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "data-bytes", &s->data_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "ram-writes", &s->ram_writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "frames", &s->frames,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "busy-level", &s->busy_level,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "nonwhite-visible",
+                                   &s->nonwhite_visible, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-command",
+                                   &s->last_command, OBJ_PROP_FLAG_READ);
+    object_property_add_str(obj, "visible-hex", epd_get_visible_hex, NULL);
+}
+static void epd_class_init(ObjectClass *klass, void *data)
+{
+    SSIPeripheralClass *ssc = SSI_PERIPHERAL_CLASS(klass);
+    ssc->transfer = epd_transfer;
+    ssc->realize = epd_realize;
+    ssc->cs_polarity = SSI_CS_LOW;
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), epd_reset);
+}
+static const TypeInfo epd_info = {
+    .name = TYPE_YBX_SSD1677,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(YbxSSD1677State),
+    .instance_init = epd_init,
+    .class_init = epd_class_init,
+};
+static void epd_register(void) { type_register_static(&epd_info); }
+type_init(epd_register)
