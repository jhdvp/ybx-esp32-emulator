diff --git a/hw/i2c/ybx_x4pro_i2c.c b/hw/i2c/ybx_x4pro_i2c.c
--- a/hw/i2c/ybx_x4pro_i2c.c
+++ b/hw/i2c/ybx_x4pro_i2c.c
@@ -227,6 +227,8 @@
 struct YbxGT911 {
     I2CSlave parent_obj;
     bool powered;
+    bool master_rail_high;
+    bool touch_power_low;
     bool reset_high;
     bool reset_low_seen;
     bool interrupt_high;
@@ -289,18 +291,35 @@
     gt911_update_irq(s);
 }
 
-static void gt911_power(void *opaque, int pin, int level)
-{
-    YbxGT911 *s = YBX_GT911(opaque);
-    bool powered = !level; /* X4 Pro power rail GPIO2 is active-LOW */
+static void gt911_refresh_power(YbxGT911 *s)
+{
+    /* Board-confirmed: GPIO1 HIGH must enable the master peripheral rail,
+     * then GPIO2 LOW enables the GT911-specific rail. */
+    bool powered = s->master_rail_high && s->touch_power_low;
     if (s->powered != powered) {
         s->powered = powered;
-        s->reset_low_seen = false;
+        /* Power applied with RESET held LOW counts toward the reset pulse. */
+        s->reset_low_seen = powered && !s->reset_high;
+        s->reset_low_since_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
         s->ready_after_ns = INT64_MAX;
         s->data_ready = false;
         s->injected_state = 0;
         gt911_update_irq(s);
     }
+}
+
+static void gt911_master_power(void *opaque, int pin, int level)
+{
+    YbxGT911 *s = YBX_GT911(opaque);
+    s->master_rail_high = !!level;
+    gt911_refresh_power(s);
+}
+
+static void gt911_power(void *opaque, int pin, int level)
+{
+    YbxGT911 *s = YBX_GT911(opaque);
+    s->touch_power_low = !level;
+    gt911_refresh_power(s);
 }
 
 static void gt911_reset_pin(void *opaque, int pin, int level)
@@ -403,6 +422,8 @@
 {
     YbxGT911 *s = YBX_GT911(device);
     s->powered = false;
+    s->master_rail_high = false;
+    s->touch_power_low = false;
     s->reset_high = true; /* virtual board reset line pulled up */
     s->reset_low_seen = false;
     s->interrupt_high = true;
@@ -421,6 +442,8 @@
 static void gt911_init(Object *obj)
 {
     YbxGT911 *s = YBX_GT911(obj);
+    qdev_init_gpio_in_named(DEVICE(s), gt911_master_power,
+                            "ybx.gt911.master-rail", 1);
     qdev_init_gpio_in_named(DEVICE(s), gt911_power, "ybx.gt911.power", 1);
     qdev_init_gpio_in_named(DEVICE(s), gt911_reset_pin, "ybx.gt911.reset", 1);
     qdev_init_gpio_in_named(DEVICE(s), gt911_int_pin, "ybx.gt911.int", 1);
