diff --git a/include/hw/gpio/esp32_gpio.h b/include/hw/gpio/esp32_gpio.h
--- a/include/hw/gpio/esp32_gpio.h
+++ b/include/hw/gpio/esp32_gpio.h
@@ -31,6 +31,9 @@
     qemu_irq pin_out[ESP32_GPIO_PINS];
     uint32_t input_lo;
     uint32_t input_hi;
+    /* Opt-in board passive pullups, X4 Pro 0/3/7 active-low buttons.
+     * Fixed at cold/reset, but inject GPIO input overrides freely. */
+    uint32_t input_pullup_lo;
     /* ESP32-S3 GPIO_INTR opt-in: 0x44/0x50 status and 0x74+n*4
      * pin type/INT_ENA; no RTC_IO, GPIO matrix or NMI modeling. */
     uint32_t gpio_status_lo;
diff --git a/hw/gpio/esp32_gpio.c b/hw/gpio/esp32_gpio.c
--- a/hw/gpio/esp32_gpio.c
+++ b/hw/gpio/esp32_gpio.c
@@ -205,7 +205,8 @@
     Esp32GpioState *s = ESP32_GPIO(obj);
     s->out_lo = s->out_hi = 0;
     s->enable_lo = s->enable_hi = 0;
-    s->input_lo = s->input_hi = 0;
+    s->input_lo = s->input_pullup_lo;
+    s->input_hi = 0;
     s->gpio_status_lo = s->gpio_status_hi = 0;
     s->irq_level = 0;
     memset(s->pin_config, 0, sizeof(s->pin_config));
@@ -243,6 +244,8 @@
     DEFINE_PROP_UINT32("strap_mode", Esp32GpioState, strap_mode, 0),
     DEFINE_PROP_BOOL("emulate-output-registers", Esp32GpioState,
                      emulate_outputs, false),
+    DEFINE_PROP_UINT32("board-input-pullups", Esp32GpioState,
+                       input_pullup_lo, 0),
     DEFINE_PROP_END_OF_LIST(),
 };
 
diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -770,6 +770,13 @@
     qdev_prop_set_bit(DEVICE(&ss->gpio), "emulate-output-registers",
                       ms->ybx_x4pro_i2c || ms->ybx_x4pro_sd_power ||
                       ms->ybx_x4pro_epd);
+    if (ms->ybx_x4pro_gt911) {
+        /* Verified hardware: side keys GPIO0/GPIO7 + power GPIO3
+         * are active-LOW and require passive pullups. Stock QEMU
+         * input_lo=0 otherwise means ALL three keys held forever. */
+        qdev_prop_set_uint32(DEVICE(&ss->gpio), "board-input-pullups",
+                            (1U << 0) | (1U << 3) | (1U << 7));
+    }
     object_initialize_child(OBJECT(ss), "rng", &ss->rng, TYPE_ESP32S3_RNG);
 
     object_initialize_child(OBJECT(ss), "clock", &ss->clock, TYPE_ESP32S3_CLOCK);
