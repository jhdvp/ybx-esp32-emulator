--- a/include/hw/xtensa/esp32s3_intc.h
+++ b/include/hw/xtensa/esp32s3_intc.h
@@ -143,6 +143,19 @@
     qemu_irq *outputs[ESP32S3_CPU_COUNT];
     uint8_t irq_map[ESP32S3_CPU_COUNT][ESP32S3_INT_MATRIX_INPUTS];
 
+    /* YBX read-only counters: the routing logic never reads them, so behaviour
