diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -157,6 +157,10 @@
     SsiPsramState *psram;
 
     uint32_t requested_reset;
+
+    /* Minimal ADC one-shot completion for firmware calibration. */
+    uint32_t adc_meas1_ctrl2;
+    uint32_t adc_meas2_ctrl2;
 } Esp32s3SocState;
 
 
@@ -207,6 +211,8 @@
         s->requested_reset = ESP32S3_SOC_RESET_ALL;
     }
     if (s->requested_reset & ESP32S3_SOC_RESET_PERIPH) {
+        s->adc_meas1_ctrl2 = 0;
+        s->adc_meas2_ctrl2 = 0;
         device_cold_reset(DEVICE(&s->intmatrix));
         for (int i = 0; i < ESP32S3_UART_COUNT; ++i) {
             device_cold_reset(DEVICE(&s->uart[i]));
@@ -460,6 +466,18 @@
 
 static uint64_t esp32s3_io_read(void *opaque, hwaddr addr, unsigned int size)
 {
+    Esp32s3SocState *soc = opaque;
+    /* SENS_SAR_MEAS{1,2}_CTRL2: report conversion done after START.
+     * The virtual sensor returns zero. This models the handshake only,
+     * not real analogue voltages or ADC accuracy. */
+    if (size == 4 && addr == DR_REG_SENS_BASE - ESP32S3_IO_START_ADDR + 0x0c) {
+        return soc->adc_meas1_ctrl2 |
+               ((soc->adc_meas1_ctrl2 & (1U << 17)) ? (1U << 16) : 0);
+    }
+    if (size == 4 && addr == DR_REG_SENS_BASE - ESP32S3_IO_START_ADDR + 0x30) {
+        return soc->adc_meas2_ctrl2 |
+               ((soc->adc_meas2_ctrl2 & (1U << 17)) ? (1U << 16) : 0);
+    }
 #if ESP32S3_IO_WARNING
     warn_report("[ESP32-S3] Unsupported read to $%08lx, size = %i\n", ESP32S3_IO_START_ADDR + addr, size);
 #endif
@@ -469,6 +487,15 @@
 
 static void esp32s3_io_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
 {
+    Esp32s3SocState *soc = opaque;
+    if (size == 4 && addr == DR_REG_SENS_BASE - ESP32S3_IO_START_ADDR + 0x0c) {
+        soc->adc_meas1_ctrl2 = (uint32_t)value & ~(1U << 16);
+        return;
+    }
+    if (size == 4 && addr == DR_REG_SENS_BASE - ESP32S3_IO_START_ADDR + 0x30) {
+        soc->adc_meas2_ctrl2 = (uint32_t)value & ~(1U << 16);
+        return;
+    }
 #if ESP32S3_IO_WARNING
         warn_report("[ESP32-S3] Unsupported write $%08lx = %08lx\n", ESP32S3_IO_START_ADDR + addr, value);
 #endif
@@ -626,7 +653,7 @@
 
 
     memory_region_init_io(&ss->iomem, OBJECT(&ss->cpu[0]), &esp32s3_io_ops,
-                          NULL, "esp32s3.iomem", 0xd1000);
+                          ss, "esp32s3.iomem", 0xd1000);
     memory_region_add_subregion(sys_mem, ESP32S3_IO_START_ADDR, &ss->iomem);
 
     // qdev_prop_set_chr(DEVICE(ss), "serial0", serial_hd(0));
