+/* The pin GPIO1 drives BOTH the GT911 and the SD slot master rail
+ * when both virtual board profiles are enabled. QEMU does not permit
+ * two independent consumers to be attached to the same output pin. */
+static void esp32s3_x4pro_shared_power(void *opaque, int pin, int level)
+{
+    Esp32s3SocState *ss = opaque;
+    qemu_set_irq(qdev_get_gpio_in_named(DEVICE(ss->ybx_gt911),
+                                       "ybx.gt911.master-rail", 0), level);
+    qemu_set_irq(qdev_get_gpio_in_named(DEVICE(&ss->sdmmc),
+                                       "ybx.sd-master-rail", 0), level);
 }
 
