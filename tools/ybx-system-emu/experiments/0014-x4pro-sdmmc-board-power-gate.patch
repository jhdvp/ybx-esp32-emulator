+static void dwc_sdmmc_board_power_update(DWCSDMMCState *s)
+{
+    if (!s->ybx_gate_sd_power) {
+        return;
+    }
+    bool powered = s->ybx_master_high && s->ybx_sd_enable_low;
+    if (powered == s->ybx_slot_powered) {
+        return;
+    }
+    s->ybx_slot_powered = powered;
+    if (s->ybx_card) {
+        SDCardClass *card_class = SD_CARD_GET_CLASS(s->ybx_card);
+        card_class->enable(s->ybx_card, powered);
+        if (powered) {
+            /* A real slot power cycle restarts card identification. */
+            device_cold_reset(DEVICE(s->ybx_card));
+        }
+    }
+}
+
+static void dwc_sdmmc_master_power(void *opaque, int n, int level)
+{
+    DWCSDMMCState *s = DWC_SDMMC(opaque);
+    s->ybx_master_high = level != 0;
+    dwc_sdmmc_board_power_update(s);
+}
+
+static void dwc_sdmmc_slot_enable(void *opaque, int n, int level)
+{
+    DWCSDMMCState *s = DWC_SDMMC(opaque);
+    s->ybx_sd_enable_low = level == 0;
+    dwc_sdmmc_board_power_update(s);
+}
 
