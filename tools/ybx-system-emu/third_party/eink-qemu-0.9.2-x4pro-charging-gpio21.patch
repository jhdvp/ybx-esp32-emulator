diff --git a/hw/input/x4pro_keys.c b/hw/input/x4pro_keys.c
index d28f63d..9036b5a 100644
--- a/hw/input/x4pro_keys.c
+++ b/hw/input/x4pro_keys.c
@@ -8,7 +8,8 @@
  * ("boot" line 1) while Power is pressed or was pressed in the last 2 s:
  * the hand that turns the device on is still on the button while the
  * firmware checks it. Software resets, watchdog resets and timer wakes boot
- * with Power released.
+ * with Power released. An independent QOM "charging" input drives the
+ * active-high charger STAT on GPIO21; the board boots on battery by default.
  *
  * This program is free software; you can redistribute it and/or modify
  * it under the terms of the GNU General Public License version 2 or
@@ -32,9 +33,11 @@ struct X4ProKeysState {
     SysBusDevice parent_obj;
     QemuInputHandlerState *input;
     qemu_irq out[KEY_COUNT];    /* pin level: 1 released, 0 pressed */
+    qemu_irq charger_status;     /* GPIO21: active HIGH only while charging */
     QEMUTimer boot_timer;
     uint32_t power_boot_ms;
     bool boot_hold;
+    bool charging;
     bool pressed[KEY_COUNT];
     int64_t power_down_ms;      /* virtual ms Power was last pressed, or -1 */
 };
@@ -48,6 +51,7 @@ static void keys_update(X4ProKeysState *s)
         bool down = s->pressed[k] || (k == KEY_POWER && s->boot_hold);
         qemu_set_irq(s->out[k], !down);
     }
+    qemu_set_irq(s->charger_status, s->charging);
 }
 
 static void keys_set(X4ProKeysState *s, int k, bool down)
@@ -85,6 +89,18 @@ KEY_PROP(up, KEY_UP)
 KEY_PROP(down, KEY_DOWN)
 KEY_PROP(power, KEY_POWER)
 
+static bool get_charging(Object *o, Error **e)
+{
+    return X4PRO_KEYS(o)->charging;
+}
+
+static void set_charging(Object *o, bool value, Error **e)
+{
+    X4ProKeysState *s = X4PRO_KEYS(o);
+    s->charging = value;
+    keys_update(s);
+}
+
 static void keys_boot_release(void *opaque)
 {
     X4ProKeysState *s = opaque;
@@ -155,11 +171,13 @@ static void keys_init(Object *obj)
 {
     X4ProKeysState *s = X4PRO_KEYS(obj);
     qdev_init_gpio_out(DEVICE(obj), s->out, KEY_COUNT);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->charger_status, "charger-status", 1);
     qdev_init_gpio_in_named(DEVICE(obj), keys_boot, "boot", 2);
     s->power_down_ms = -1;
     object_property_add_bool(obj, "up", get_up, set_up);
     object_property_add_bool(obj, "down", get_down, set_down);
     object_property_add_bool(obj, "power", get_power, set_power);
+    object_property_add_bool(obj, "charging", get_charging, set_charging);
 }
 
 static const Property keys_properties[] = {
diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
index e3986ea..d3eccc2 100644
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -1233,6 +1233,9 @@ static void x4pro_board_init(Esp32s3SocState *ss, DeviceState *spi2)
         qdev_connect_gpio_out(keys, k, qdev_get_gpio_in_named(gpio, ESP32S3_GPIO_IN, key_pins[k]));
     }
     x4pro_connect_boot(ss, keys);
+    /* X4 Pro charger STAT: GPIO21, active HIGH. Default is battery (LOW). */
+    qdev_connect_gpio_out_named(keys, "charger-status", 0,
+                                qdev_get_gpio_in_named(gpio, ESP32S3_GPIO_IN, 21));
     sysbus_realize_and_unref(SYS_BUS_DEVICE(keys), &error_fatal);
 
     DeviceState *i2c0 = DEVICE(object_resolve_path_component(OBJECT(ss), "i2c0"));
